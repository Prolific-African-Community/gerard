# Base Gerard : unique source de verite, en local comme en deploiement.
DATABASE_URL=""
# Compte administrateur cree/garanti par "npm run bootstrap:admin".
GERARD_ADMIN_USERNAME="gerard.superadmin"
GERARD_ADMIN_PASSWORD=""
GERARD_ADMIN_EMAIL=""
# Compte chauffeur cree par le bootstrap initial ("npm run bootstrap:seed").
GERARD_DRIVER_USERNAME=""
GERARD_DRIVER_PASSWORD=""
GERARD_DRIVER_EMAIL=""
JWT_SECRET=""
# Hôtes plateforme Gerard (séparés par des virgules). Les domaines tenant sont en base.
GERARD_PLATFORM_HOSTNAMES=""
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_FIRST_NAME=""
INITIAL_ADMIN_LAST_NAME=""
INITIAL_ADMIN_TEMP_PASSWORD=""
ADMIN_RESET_TEMP_PASSWORD=""
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
DISPATCH_BASE_LATITUDE=""
DISPATCH_BASE_LONGITUDE=""
BLOB_READ_WRITE_TOKEN=""
# Les valeurs non sensibles vivent dans OrganizationIntegration.configJson.
# Format temporaire du provider ENV : GERARD_INTEGRATION_SECRET_<SECRET_REF>_<KEY>.
# Exemples de clés : USERNAME, PASSWORD, OUTBOUND_API_KEY, INBOUND_WEBHOOK_SECRET.
GERARD_INTEGRATION_SECRET_QA_MAIL_USERNAME=""
GERARD_INTEGRATION_SECRET_QA_MAIL_PASSWORD=""
GERARD_INTEGRATION_SECRET_QA_SL_OUTBOUND_API_KEY=""
GERARD_INTEGRATION_SECRET_QA_SL_INBOUND_WEBHOOK_SECRET=""
DEV_CLEANUP_KEY="local-cleanup-secret"
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_ROUTES_MAX_CALLS_PER_OPERATION=10

# Run 7E2 legacy migrator only. Both connections are forced read-only by the tool.
LEGACY_SOURCE_DATABASE_URL=""
LEGACY_TARGET_DATABASE_URL=""
