# LOCAL — normal Gerard development. Never paste production credentials here.
DATABASE_URL="postgresql://local-user:local-password@localhost:5432/gerard_dev"
JWT_SECRET="replace-with-a-local-development-secret"
GERARD_ADMIN_USERNAME="gerard.superadmin"
GERARD_ADMIN_PASSWORD="replace-with-a-local-temporary-password"
GERARD_ADMIN_EMAIL="admin@example.test"
GERARD_PLATFORM_HOSTNAMES="localhost"

# LOCAL / OPTIONAL — disabled or capped by default to avoid provider costs.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_ROUTES_MAX_CALLS_PER_OPERATION="0"
DISPATCH_BASE_LATITUDE=""
DISPATCH_BASE_LONGITUDE=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
BLOB_READ_WRITE_TOKEN=""

# CUSTOM INSTANCE — deploy-time identity, configured per application.
GERARD_APPLICATION_ID="default"
GERARD_INSTANCE_ORGANIZATION_ID=""
GERARD_INSTANCE_ENVIRONMENT="development"
NEXT_PUBLIC_GERARD_APPLICATION="default"

# OPTIONAL INTEGRATIONS — non-sensitive configuration belongs in
# OrganizationIntegration.configJson. Secrets are resolved from secretRef.
# For secretRef=CLIENT_X_MAIL:
GERARD_INTEGRATION_SECRET_CLIENT_X_MAIL_USERNAME=""
GERARD_INTEGRATION_SECRET_CLIENT_X_MAIL_PASSWORD=""
# For secretRef=CLIENT_X_SL:
GERARD_INTEGRATION_SECRET_CLIENT_X_SL_OUTBOUNDAPIKEY=""
GERARD_INTEGRATION_SECRET_CLIENT_X_SL_INBOUNDWEBHOOKSECRET=""

# MAINTENANCE ONLY — inject temporarily when explicitly running these tools.
# Do not keep production URLs or reset credentials in normal local/Vercel runtime.
LEGACY_SOURCE_DATABASE_URL=""
LEGACY_TARGET_DATABASE_URL=""
ADMIN_RESET_TEMP_PASSWORD=""
DEV_CLEANUP_KEY=""
