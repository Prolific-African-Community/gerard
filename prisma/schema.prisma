generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DISPATCHER
  SECRETARY
  PARK_MANAGER
  DRIVER
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_SUPPORT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  ORG_ADMIN
  MANAGER
  DISPATCHER
  SECRETARY
  ACCOUNTING
  DRIVER
  VIEWER
}

enum OrganizationModule {
  PLANNING
  MAP
  PROFITABILITY
  INVOICING
  FLEET
  INTELLIGENCE
  ASSISTANT
  MAINTENANCE
}

enum OrganizationIntegrationType {
  MAIL_INTAKE
  SL_AUTOMOTIVE
}

enum PlatformAuditAction {
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_STATUS_CHANGED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  MEMBER_STATUS_CHANGED
  PASSWORD_RESET
  SESSION_INVALIDATED
  MODULES_CHANGED
  BRANDING_CHANGED
  DOMAIN_CREATED
  DOMAIN_UPDATED
  DOMAIN_DELETED
  BILLING_CONFIG_CHANGED
  INTEGRATION_CHANGED
}

enum PlanningAssignmentOrigin {
  MANUAL
  AUTOMATIC
  ADJUSTED
}

enum DriverStatus {
  ACTIVE
  UNAVAILABLE
  ON_LEAVE
  INACTIVE
}

enum TruckStatus {
  AVAILABLE
  ASSIGNED
  EN_ROUTE_TO_PICKUP
  AT_PICKUP
  ON_MISSION
  RETURNING_TO_BASE
  AT_BASE
  IN_MAINTENANCE
  MAINTENANCE_EXT
  OUT_OF_SERVICE
}

enum TrailerType {
  CURTAINSIDER
  FLATBED
  REFRIGERATED
  CONTAINER
  BOX
  OTHER
}

enum TrailerStatus {
  AVAILABLE
  ASSIGNED
  AT_BASE
  IN_MAINTENANCE
  MAINTENANCE_EXT
  OUT_OF_SERVICE
}

enum TrailerLoadStatus {
  EMPTY
  LOADED
}

enum TrailerCustodyState {
  EMPTY
  LOADED
  IN_MISSION
  AT_BASE
  RELAY_AVAILABLE
  DELIVERED
  IMMOBILIZED
}

enum TrailerCustodyTransitionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum TrailerCargoType {
  WOOD
  ALUMINIUM
  STEEL
  PALLETS
  CONSTRUCTION_MATERIALS
  FOOD
  MACHINERY
  TEXTILE
  CHEMICALS
  OTHER
}

enum MaintenanceVehicleType {
  TRUCK
  TRAILER
}

enum MaintenanceInterventionType {
  DIAGNOSTIC
  TIRES
  BRAKES
  OIL_SERVICE
  ELECTRICAL
  BODYWORK
  TRAILER_REPAIR
  SAFETY_CHECK
  OTHER
}

enum MaintenanceUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum MaintenanceRequestStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  UNDER_REVIEW
  QUOTE_RECEIVED
  QUOTE_APPROVED
  QUOTE_REJECTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CLOSED
  CANCELLED
}

enum MissionStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  DONE
  ISSUE
  CANCELLED
}

enum MissionPreparationStatus {
  PENDING
  PROCESSING
  READY
  REVIEW_REQUIRED
  FAILED
}

enum AddressResolutionStatus {
  PENDING
  AUTO_CONFIRMED
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
}

enum AddressResolutionMethod {
  PROVIDED_COORDINATES
  GOOGLE_PLACES
  MANUAL
}

enum RegulatoryStateSource {
  TACHOGRAPH
  DISPATCHER_DECLARATION
  QA
  UNKNOWN
}

enum DriverActivityType {
  DRIVE_START
  DRIVE_END
  OTHER_WORK
  BREAK
  SPLIT_BREAK
  DAILY_REST
  WEEKLY_REST
  UNAVAILABLE
  AVAILABLE
}

enum DriverActivitySource {
  DRIVER
  DISPATCHER_CORRECTION
  MISSION
  SYSTEM
  QA
}

enum PlanningDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MissionEventType {
  CREATED
  ASSIGNED
  UNASSIGNED
  RESCHEDULED
  STATUS_CHANGED
  DRIVER_CHANGED
  TRUCK_CHANGED
  NOTE_ADDED
  COMPLETED
  CANCELLED
  ISSUE_REPORTED
}

enum ParkSpotType {
  PARKING
  WORKSHOP
  HALL
  STORAGE
}

enum ParkVehicleType {
  TRUCK
  TRAILER
}

enum ParkMovementAction {
  PLACE
  MOVE
  REMOVE
}

enum ParkInspectionStatus {
  DRAFT
  FINALIZED
}

enum ParkInspectionOverallResult {
  COMPLIANT
  WATCH
  INTERVENTION_REQUIRED
}

enum ParkInspectionItemStatus {
  OK
  WATCH
  CRITICAL
  NOT_APPLICABLE
}

enum InvoiceDirection {
  ISSUED
  RECEIVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  RECEIVED
  TO_REVIEW
  APPROVED
  PAID
  OVERDUE
  CANCELLED
  REJECTED
}

model User {
  id                        String        @id @default(cuid())
  name                      String
  firstName                 String        @default("")
  lastName                  String        @default("")
  email                     String?       @unique
  username                  String        @unique
  passwordHash              String?
  role                      UserRole      @default(DISPATCHER)
  platformRole              PlatformRole?
  isActive                  Boolean       @default(true)
  mustChangePassword        Boolean       @default(true)
  lastLoginAt               DateTime?
  passwordChangedAt         DateTime?
  temporaryPasswordIssuedAt DateTime?
  sessionVersion            Int           @default(0)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  events                           MissionEvent[]
  truckEvents                      TruckEvent[]
  parkPlacements                   ParkSpot[]                        @relation("ParkSpotPlacedBy")
  parkMovements                    ParkMovement[]                    @relation("ParkMovementActor")
  parkInspections                  ParkInspection[]                  @relation("ParkInspectionInspector")
  dispatchOptimizationApplications DispatchOptimizationApplication[]
  regulatoryDeclarations           DriverRegulatoryDeclaration[]
  driverActivityEvents             DriverActivityEvent[]             @relation("DriverActivityAuthor")
  trailerCustodyEvents             TrailerCustodyEvent[]
  organizationMemberships          OrganizationUser[]
  platformAuditLogs                PlatformAuditLog[]
  driverId                         String?                           @unique
  driver                           Driver?                           @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([isActive])
  @@index([username])
  @@index([driverId])
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  status         OrganizationStatus   @default(ACTIVE)
  enabledModules OrganizationModule[] @default([PLANNING, MAP, PROFITABILITY, INVOICING, FLEET, INTELLIGENCE, ASSISTANT, MAINTENANCE])
  displayName    String?
  logoUrl        String?
  accentColor    String?
  faviconUrl     String?
  applicationTitle String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  users                            OrganizationUser[]
  drivers                          Driver[]
  trucks                           Truck[]
  trailers                         Trailer[]
  clientProfiles                   ClientProfile[]
  missions                         Mission[]
  invoices                         Invoice[]
  invoiceLines                     InvoiceLine[]
  invoiceMissions                  InvoiceMission[]
  planningRows                     PlanningRow[]
  missionAssignments               MissionAssignment[]
  trailerCustodyEvents             TrailerCustodyEvent[]
  missionEvents                    MissionEvent[]
  dispatchOptimizationApplications DispatchOptimizationApplication[]
  driverRegulatoryDeclarations     DriverRegulatoryDeclaration[]
  driverActivityEvents             DriverActivityEvent[]
  truckEvents                      TruckEvent[]
  truckPositions                   TruckPosition[]
  driverPositions                  DriverPosition[]
  ignoredMailImports               IgnoredMailImport[]
  maintenanceRequests              MaintenanceRequest[]
  maintenanceStatusHistory         MaintenanceStatusHistory[]
  maintenanceInterventionLines     MaintenanceInterventionLine[]
  weeklyProfitabilityAdjustments   WeeklyProfitabilityAdjustment[]
  missionSourceEmails              MissionSourceEmail[]
  parkSpots                        ParkSpot[]
  parkMovements                    ParkMovement[]
  parkInspections                  ParkInspection[]
  parkInspectionResults            ParkInspectionResult[]
  platformAuditLogs                PlatformAuditLog[]
  domains                         OrganizationDomain[]
  billingConfig                   OrganizationBillingConfig?
  integrations                    OrganizationIntegration[]

  @@index([status])
}

model OrganizationBillingConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  legalName        String
  legalAddress     String?
  vatNumber        String?
  iban             String?
  bic              String?
  bankName         String?
  beneficiary      String?
  invoicePrefix    String?
  paymentTermsDays Int?
  billingEmail     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationIntegration {
  id             String                      @id @default(cuid())
  organizationId String
  type           OrganizationIntegrationType
  enabled        Boolean                     @default(false)
  configJson     Json                        @default("{}")
  secretRef      String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId, enabled])
}

model OrganizationDomain {
  id             String       @id @default(cuid())
  organizationId String
  hostname       String
  pathPrefix     String       @default("")
  isPrimary      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([hostname, pathPrefix])
  @@index([organizationId, isActive])
  @@index([hostname, isActive])
}

model PlatformAuditLog {
  id             String              @id @default(cuid())
  actorUserId    String
  organizationId String
  action         PlatformAuditAction
  metadata       Json?
  createdAt      DateTime            @default(now())

  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model OrganizationUser {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Driver {
  id                 String       @id @default(cuid())
  organizationId     String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name               String
  phone              String?
  email              String?
  status             DriverStatus @default(ACTIVE)
  hourlyCostAmount   Float?
  hourlyCostCurrency String       @default("EUR")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  usualTruck             Truck?                        @relation("DriverUsualTruck")
  user                   User?
  assignments            MissionAssignment[]
  events                 MissionEvent[]
  planningRows           PlanningRow[]
  positions              DriverPosition[]
  regulatoryDeclarations DriverRegulatoryDeclaration[]
  activityEvents         DriverActivityEvent[]
  custodyEventsFrom      TrailerCustodyEvent[]         @relation("TrailerCustodyFromDriver")
  custodyEventsTo        TrailerCustodyEvent[]         @relation("TrailerCustodyToDriver")

  @@index([status])
  @@index([organizationId])
}

model Truck {
  id                           String       @id @default(cuid())
  organizationId               String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plateNumber                  String
  model                        String?
  brand                        String?
  status                       TruckStatus  @default(AVAILABLE)
  statusUpdatedAt              DateTime?
  technicalInspectionDate      DateTime?
  technicalInspectionExpiresAt DateTime?
  returnToBaseDistanceMeters   Int?
  returnToBaseDurationSeconds  Int?
  returnToBasePolyline         String?
  returnToBaseCalculatedAt     DateTime?
  returnToBaseProvider         String?
  category                     String?
  capacityKg                   Int?
  couplingType                 String?

  driverId String? @unique
  driver   Driver? @relation("DriverUsualTruck", fields: [driverId], references: [id], onDelete: SetNull)

  gpsDeviceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments         MissionAssignment[]
  planningRows        PlanningRow[]
  positions           TruckPosition[]
  driverPositions     DriverPosition[]
  missionEvents       MissionEvent[]
  events              TruckEvent[]
  trailers            Trailer[]
  maintenanceRequests MaintenanceRequest[]
  parkSpot            ParkSpot?
  parkMovements       ParkMovement[]
  parkInspections     ParkInspection[]

  @@unique([organizationId, plateNumber])
  @@index([driverId])
  @@index([status])
  @@index([gpsDeviceId])
  @@index([organizationId])
}

model Trailer {
  id                           String              @id @default(cuid())
  organizationId               String              @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization                 Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plateNumber                  String
  type                         TrailerType
  status                       TrailerStatus       @default(AVAILABLE)
  technicalInspectionDate      DateTime?
  technicalInspectionExpiresAt DateTime?
  loadStatus                   TrailerLoadStatus   @default(EMPTY)
  cargoType                    TrailerCargoType?
  compatibleCargoTypes         Json?
  cargoDescription             String?
  truckId                      String?
  notes                        String?
  capacityKg                   Int?
  couplingType                 String?
  custodyState                 TrailerCustodyState @default(EMPTY)
  custodyVersion               Int                 @default(0)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  truck Truck? @relation(fields: [truckId], references: [id], onDelete: SetNull)

  planningRows        PlanningRow[]
  assignments         MissionAssignment[]
  missionEvents       MissionEvent[]
  maintenanceRequests MaintenanceRequest[]
  parkSpot            ParkSpot?
  parkMovements       ParkMovement[]
  parkInspections     ParkInspection[]
  custodyEvents       TrailerCustodyEvent[]

  @@unique([organizationId, plateNumber])
  @@index([truckId])
  @@index([status])
  @@index([type])
  @@index([loadStatus])
  @@index([cargoType])
  @@index([organizationId])
}

model ClientProfile {
  id                             String       @id @default(cuid())
  organizationId                 String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                           String
  legalName                      String?
  displayName                    String?
  emailDomains                   Json?
  contactEmails                  Json?
  contactPhones                  Json?
  billingInfo                    Json?
  defaultPaymentTerms            String?
  defaultTruckType               String?
  defaultTrailerType             String?
  defaultPreAnnouncementRequired Boolean      @default(false)
  defaultRequirements            Json?
  defaultContacts                Json?
  operationalNotes               String?
  parserHints                    Json?
  isActive                       Boolean      @default(true)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([name])
  @@index([isActive])
  @@index([organizationId])
}

model Mission {
  id                           String                   @id @default(cuid())
  organizationId               String                   @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization                 Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reference                    String
  title                        String?
  clientName                   String?
  pickupCity                   String?
  deliveryCity                 String?
  pickupAddress                String?
  deliveryAddress              String?
  pickupPlaceId                String?
  deliveryPlaceId              String?
  pickupLat                    Float?
  pickupLng                    Float?
  deliveryLat                  Float?
  deliveryLng                  Float?
  estimatedKm                  Int?
  clientReference              String?
  cmrNumber                    String?
  deliveryNoteNumber           String?
  pickupDate                   DateTime?
  deliveryDate                 DateTime?
  requiredTruckType            String?
  priceAmount                  Float?
  priceCurrency                String?
  paymentTerms                 String?
  preAnnouncementRequired      Boolean                  @default(false)
  preAnnouncementSent          Boolean                  @default(false)
  preAnnouncementSentAt        DateTime?
  requirements                 Json?
  contacts                     Json?
  billingInfo                  Json?
  routeDistanceMeters          Int?
  routeDurationSeconds         Int?
  routePolyline                String?
  routeCalculatedAt            DateTime?
  routeProvider                String?
  pickupSourceAddress          String?
  deliverySourceAddress        String?
  pickupNormalizedAddress      String?
  deliveryNormalizedAddress    String?
  pickupResolvedAddress        String?
  deliveryResolvedAddress      String?
  pickupResolutionStatus       AddressResolutionStatus  @default(PENDING)
  deliveryResolutionStatus     AddressResolutionStatus  @default(PENDING)
  pickupResolutionMethod       AddressResolutionMethod?
  deliveryResolutionMethod     AddressResolutionMethod?
  pickupResolutionConfidence   Float?
  deliveryResolutionConfidence Float?
  pickupResolvedAt             DateTime?
  deliveryResolvedAt           DateTime?
  pickupResolutionReason       String?
  deliveryResolutionReason     String?
  pickupResolutionCandidates   Json?
  deliveryResolutionCandidates Json?
  preparationStatus            MissionPreparationStatus @default(PENDING)
  preparationMissingData       Json?
  preparationLastAttemptAt     DateTime?
  preparationError             String?
  status                       MissionStatus            @default(PENDING)
  notes                        String?

  sourceEmailId      String?
  sourceEmailFrom    String?
  sourceEmailSubject String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment           MissionAssignment?
  events               MissionEvent[]
  driverActivityEvents DriverActivityEvent[]
  invoices             Invoice[]
  invoiceMissions      InvoiceMission[]
  sourceEmail          MissionSourceEmail?
  trailerCustodyEvents TrailerCustodyEvent[]

  @@unique([organizationId, reference])
  @@index([status])
  @@index([clientName])
  @@index([sourceEmailId])
  @@index([createdAt])
  @@index([organizationId])
}

model Invoice {
  id                    String           @id @default(cuid())
  organizationId        String           @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  direction             InvoiceDirection
  invoiceNumber         String?
  externalInvoiceNumber String?
  status                InvoiceStatus    @default(DRAFT)
  missionId             String?
  maintenanceRequestId  String?
  issueDate             DateTime?
  dueDate               DateTime?
  paidDate              DateTime?
  sellerName            String
  sellerAddress         String?
  sellerVatNumber       String?
  sellerIban            String?
  sellerBic             String?
  sellerBankName        String?
  sellerBeneficiary     String?
  buyerName             String
  buyerAddress          String?
  buyerVatNumber        String?
  buyerEmail            String?
  missionReference      String?
  clientReference       String?
  cmrNumber             String?
  deliveryNoteNumber    String?
  missionDescription    String?
  subtotalAmount        Decimal          @default(0)
  vatAmount             Decimal          @default(0)
  totalAmount           Decimal          @default(0)
  paidAmount            Decimal          @default(0)
  currency              String           @default("EUR")
  paymentTerms          String?
  notes                 String?
  sourcePdfUrl          String?
  sourcePdfFileName     String?
  sourcePdfMimeType     String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  mission         Mission?         @relation(fields: [missionId], references: [id], onDelete: SetNull)
  lines           InvoiceLine[]
  invoiceMissions InvoiceMission[]

  @@unique([organizationId, invoiceNumber])
  @@index([direction])
  @@index([status])
  @@index([missionId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([sourcePdfUrl])
  @@index([organizationId])
}

model InvoiceLine {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceId      String
  label          String
  description    String?
  quantity       Decimal      @default(1)
  unitPrice      Decimal      @default(0)
  vatRate        Decimal      @default(17)
  subtotalAmount Decimal      @default(0)
  vatAmount      Decimal      @default(0)
  totalAmount    Decimal      @default(0)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([position])
  @@index([organizationId])
}

/// Snapshots of the missions billed by an invoice. The legacy Invoice.missionId
/// remains available for historical single-mission invoices.
model InvoiceMission {
  id                         String       @id @default(cuid())
  organizationId             String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceId                  String
  missionId                  String
  missionReferenceSnapshot   String
  clientReferenceSnapshot    String?
  cmrNumberSnapshot          String?
  deliveryNoteNumberSnapshot String?
  amountSnapshot             Decimal      @default(0)
  currencySnapshot           String       @default("EUR")
  sortOrder                  Int          @default(0)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, missionId])
  @@index([missionId])
  @@index([invoiceId, sortOrder])
  @@index([organizationId])
}

model PlanningRow {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  weekStartDate  DateTime
  sortOrder      Int          @default(0)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  truckId String?
  truck   Truck?  @relation(fields: [truckId], references: [id], onDelete: SetNull)

  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id], onDelete: SetNull)

  pairLocked               Boolean                  @default(false)
  assignmentOrigin         PlanningAssignmentOrigin @default(MANUAL)
  isExceptionalReplacement Boolean                  @default(false)
  usualTruckIdSnapshot     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments          MissionAssignment[]
  trailerCustodyEvents TrailerCustodyEvent[]

  @@unique([organizationId, weekStartDate, driverId])
  @@unique([organizationId, weekStartDate, truckId])
  @@index([weekStartDate, sortOrder])
  @@index([driverId])
  @@index([truckId])
  @@index([trailerId])
  @@index([organizationId])
}

model MissionAssignment {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  missionId String  @unique
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  planningRowId String?
  planningRow   PlanningRow? @relation(fields: [planningRowId], references: [id], onDelete: SetNull)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  truckId String?
  truck   Truck?  @relation(fields: [truckId], references: [id], onDelete: SetNull)

  /// Remorque planifiée pour cette mission. Distincte de Trailer.truckId,
  /// qui décrit uniquement l'attelage physique courant.
  trailerId            String?
  trailer              Trailer? @relation(fields: [trailerId], references: [id], onDelete: SetNull)
  trailerChangePlanned Boolean  @default(false)
  trailerTransitions   Json?

  day           PlanningDay
  scheduledDate DateTime
  plannedEndAt  DateTime?

  sortOrder Int @default(0)

  approachDistanceMeters  Int?
  approachDurationSeconds Int?
  approachPolyline        String?
  approachCalculatedAt    DateTime?
  approachProvider        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planningRowId, scheduledDate])
  @@index([driverId, scheduledDate])
  @@index([truckId, scheduledDate])
  @@index([trailerId, scheduledDate])
  @@index([trailerId, plannedEndAt])
  @@index([day])
  @@index([scheduledDate])
  @@index([organizationId])
}

/// Journal append-only de la garde et du chargement d'une remorque.
/// Une reprise de relais modifie l'affectation courante, mais ne réécrit
/// jamais les transitions précédentes.
model TrailerCustodyEvent {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  trailerId String
  trailer   Trailer @relation(fields: [trailerId], references: [id], onDelete: Restrict)

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  fromDriverId String?
  fromDriver   Driver?                        @relation("TrailerCustodyFromDriver", fields: [fromDriverId], references: [id], onDelete: SetNull)
  toDriverId   String?
  toDriver     Driver?                        @relation("TrailerCustodyToDriver", fields: [toDriverId], references: [id], onDelete: SetNull)
  fromState    TrailerCustodyState
  toState      TrailerCustodyState
  status       TrailerCustodyTransitionStatus @default(COMPLETED)
  location     String?
  note         String?
  occurredAt   DateTime                       @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt     DateTime     @default(now())
  planningRow   PlanningRow? @relation(fields: [planningRowId], references: [id], onDelete: SetNull)
  planningRowId String?

  @@index([trailerId, occurredAt])
  @@index([missionId, occurredAt])
  @@index([fromDriverId, occurredAt])
  @@index([toDriverId, occurredAt])
  @@index([planningRowId, occurredAt])
  @@index([organizationId])
}

model MissionEvent {
  id             String           @id @default(cuid())
  organizationId String           @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
