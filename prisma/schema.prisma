/// Minimal immutable audit and idempotency record for confirmed automatic
/// planning applications. Simulation payloads are never stored here.
model DispatchOptimizationApplication {
  id                  String       @id @default(cuid())
  organizationId      String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  idempotencyKey      String
  simulationId        String
  snapshotFingerprint String
  strategy            String
  periodStart         DateTime
  periodEnd           DateTime
  missionIds          Json
  pairRowIds          Json
  resultSummary       Json
  warnings            Json?
  actorId             String
  createdAt           DateTime     @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([actorId, createdAt])
  @@index([simulationId])
  @@index([periodStart, periodEnd])
  @@index([organizationId])
}

model DriverRegulatoryDeclaration {
  id                                   String                @id @default(cuid())
  organizationId                       String                @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization                         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  driverId                             String
  source                               RegulatoryStateSource
  referenceAt                          DateTime
  validUntil                           DateTime?
  timeZone                             String                @default("Europe/Luxembourg")
  drivingSinceValidBreakSeconds        Int
  dailyDrivingSeconds                  Int
  weeklyDrivingSeconds                 Int
  previousWeekDrivingSeconds           Int
  dailyExtensionsUsedThisWeek          Int
  reducedDailyRestsUsedSinceWeeklyRest Int
  splitBreakFirstPartSeconds           Int                   @default(0)
  splitDailyRestFirstPartSeconds       Int                   @default(0)
  lastValidRestEndedAt                 DateTime
