/// Immutable activity journal. A correction appends a new event and references
/// the corrected event; it never overwrites the driver's original declaration.
model DriverActivityEvent {
  id             String               @id @default(cuid())
  organizationId String               @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  driverId       String
  type           DriverActivityType
  effectiveAt    DateTime
  recordedAt     DateTime             @default(now())
  source         DriverActivitySource
  note           String?
  authorUserId   String
  missionId      String?
  latitude       Float?
  longitude      Float?
  retrospective  Boolean              @default(false)
  isVoided       Boolean              @default(false)

  correctedEventId    String?
  previousType        DriverActivityType?
  previousEffectiveAt DateTime?
  previousNote        String?
  correctionReason    String?

  createdAt DateTime @default(now())

  driver         Driver                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  authorUser     User                  @relation("DriverActivityAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  mission        Mission?              @relation(fields: [missionId], references: [id], onDelete: SetNull)
  correctedEvent DriverActivityEvent?  @relation("DriverActivityCorrection", fields: [correctedEventId], references: [id], onDelete: SetNull)
  corrections    DriverActivityEvent[] @relation("DriverActivityCorrection")

  @@index([driverId, effectiveAt])
  @@index([driverId, recordedAt])
  @@index([authorUserId])
  @@index([missionId])
  @@index([correctedEventId])
  @@index([source])
  @@index([organizationId])
}

model TruckEvent {
