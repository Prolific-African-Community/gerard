/// A stable, locatable position on the Sedan site plan.
/// Occupation is stored inline: a spot holds at most one truck and at most one
/// trailer. The @unique on truckId/trailerId guarantees a vehicle can never be
/// present on two spots at once (enforced at the database level).
model ParkSpot {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  zone           String
  label          String
  type           ParkSpotType @default(PARKING)

  posX      Float
  posY      Float
  width     Float
  height    Float
  rotation  Float   @default(0)
  sortOrder Int     @default(0)
  capacity  Int     @default(1)
  isActive  Boolean @default(true)

  truckId    String?   @unique
  trailerId  String?   @unique
  occupiedAt DateTime?
  placedById String?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  truck    Truck?   @relation(fields: [truckId], references: [id], onDelete: SetNull)
  trailer  Trailer? @relation(fields: [trailerId], references: [id], onDelete: SetNull)
  placedBy User?    @relation("ParkSpotPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([zone])
  @@index([type])
  @@index([isActive])
  @@index([sortOrder])
  @@index([organizationId])
}

/// Immutable audit log of every vehicle movement on the park. Never edited or
/// deleted from the UI. Location codes are snapshotted so history stays
/// readable even if a spot is later renamed.
model ParkMovement {
  id             String             @id @default(cuid())
  organizationId String             @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicleType    ParkVehicleType
  truckId        String?
  trailerId      String?
  plateNumber    String
  action         ParkMovementAction
  fromSpotId     String?
  fromSpotCode   String?
  toSpotId       String?
  toSpotCode     String?
  actorId        String?
  actorName      String?
  note           String?
  createdAt      DateTime           @default(now())

  truck   Truck?   @relation(fields: [truckId], references: [id], onDelete: SetNull)
  trailer Trailer? @relation(fields: [trailerId], references: [id], onDelete: SetNull)
  actor   User?    @relation("ParkMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([truckId, createdAt])
  @@index([trailerId, createdAt])
  @@index([createdAt])
  @@index([actorId])
  @@index([organizationId])
}

/// Traceable vehicle checklist. Finalized inspections are immutable at the API
/// layer; a correction is recorded as a new inspection.
model ParkInspection {
  id             String                       @id @default(cuid())
  organizationId String                       @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicleType    ParkVehicleType
  truckId        String?
  trailerId      String?
  inspectedAt    DateTime
  inspectorId    String?
  inspectorName  String
  status         ParkInspectionStatus         @default(DRAFT)
  overallResult  ParkInspectionOverallResult?
  mileage        Int?
  generalComment String?
  finalizedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  truck     Truck?                 @relation(fields: [truckId], references: [id], onDelete: Restrict)
  trailer   Trailer?               @relation(fields: [trailerId], references: [id], onDelete: Restrict)
  inspector User?                  @relation("ParkInspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  results   ParkInspectionResult[]

  @@index([truckId, inspectedAt])
  @@index([trailerId, inspectedAt])
  @@index([status])
  @@index([overallResult])
  @@index([inspectorId])
  @@index([organizationId])
}

/// One normalized answer or numeric measurement in an inspection. Tire
/// pressures remain queryable values rather than an opaque JSON/text payload.
model ParkInspectionResult {
  id                   String                   @id @default(cuid())
  organizationId       String                   @default(dbgenerated("current_setting('gerard.organization_id', true)"))
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inspectionId         String
  category             String
  itemKey              String
  label                String
  status               ParkInspectionItemStatus
  numericValue         Float?
  unit                 String?
  comment              String?
  sortOrder            Int                      @default(0)
  maintenanceRequestId String?                  @unique
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  inspection         ParkInspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)

  @@unique([inspectionId, itemKey])
  @@index([inspectionId, category, sortOrder])
  @@index([status])
  @@index([organizationId])
}

/// Cache partagé des itinéraires externes. Les coordonnées sont normalisées
/// par le service de routing avant fingerprint afin d'absorber le bruit GPS.
model RouteCache {
  id                String   @id @default(cuid())
  fingerprint       String   @unique
  originLat         Float
  originLng         Float
  destinationLat    Float
  destinationLng    Float
  waypoints         Json
  travelMode        String
  routingPreference String
  distanceMeters    Int
  durationSeconds   Int
  /// Optional for legacy metric-only routes. Callers that render geometry
  /// must explicitly require a polyline and will not consume these entries.
  polyline          String?
  provider          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([originLat, originLng, destinationLat, destinationLng], map: "RouteCache_originLat_originLng_destinationLat_destinationLng_id")
  @@index([updatedAt])
}

/// Court-circuit persistant pour éviter de marteler Google après un quota,
/// timeout ou incident 5xx. Aucune distance n'est stockée ici.
model RouteFailureCache {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  errorCode   String
  retryAfter  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([retryAfter])
}
